# Template for the NestJS host app that mounts AuthOidcModule.
# Copy to .env and fill in real values. Do not commit .env.
# Authoritative field list: manifest.ts -> integration.config.envVars

OIDC_ISSUER_URL=https://keycloak.example/realms/your-realm
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

OIDC_REDIRECT_URI=http://localhost:4070/auth-oidc/callback
OIDC_SCOPE=openid email profile

JWT_SECRET=replace-with-at-least-32-char-random-secret
JWT_EXPIRES_IN=1h

FRONTEND_URL=http://localhost:4071/m/auth-oidc/render/me?from=callback
AUTH_COOKIE_NAME=auth_token

# --- RP-initiated (single) logout: opt-in, all optional (v1.3.0) ---
# Leave unset for the default local-only logout (1.2.0 behavior). Set to true
# to also end the IdP SSO session at logout (no Keycloak confirmation page).
# OIDC_RP_INITIATED_LOGOUT=true
# Where the IdP returns after logout (defaults to FRONTEND_URL). MUST be a
# "Valid Post Logout Redirect URI" on the IdP client. Used only when the flag
# above is true.
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4071/login
# Name of the httpOnly cookie holding the id_token for id_token_hint.
# OIDC_ID_TOKEN_COOKIE_NAME=auth_id_token

# Host app: express-session (required before OIDC routes for state/nonce)
SESSION_SECRET=replace-with-at-least-32-char-random-secret
